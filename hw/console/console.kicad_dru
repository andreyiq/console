(version 1)

# Собственные правила проверки — то, чего нет в настройках платы.
#
# Общий зазор на плате 0.2 мм: это то, что проверенно держит домашний процесс
# (ЛУТ плюс сверловка на ЧПУ, 10-mech.md §5). Но у корпуса F133 зазор между
# соседними площадками 0.17 мм — свойство самого eLQFP-128 с шагом 0.4, и
# изменить его нельзя: посадочное место взято из библиотеки Allwinner и
# совпадает с ней побайтово (README, «Библиотеки»). Штатный футпринт KiCad, к
# слову, ещё теснее — 0.15 мм.
#
# Поэтому площадкам U1 между собой разрешаем 0.15 мм, всей остальной плате
# по-прежнему 0.2. Это единственное место, где процесс работает на пределе, и
# ослабление сознательное — не «чтобы DRC замолчал».
#
# `memberOfFootprint` — а не `A.Reference == 'U1'`: сравнение по Reference
# правило не отбирает и молча оставляет все 121 нарушение на месте.
(rule "F133: свои площадки теснее общего правила"
	(condition "A.memberOfFootprint('U1') && B.memberOfFootprint('U1')")
	(constraint clearance (min 0.15mm)))
